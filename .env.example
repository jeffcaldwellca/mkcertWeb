# mkcert Web UI configuration
#
# Copy to .env and uncomment what you need. The values shown are the defaults
# unless a comment says otherwise. This lists every variable the server reads,
# including a few that are read but currently have no effect (marked so).
#
# Any variable that is set here (even to an empty value) overrides the value
# saved on the settings page (config/settings.json). Leave a line commented out
# if you want to manage that setting from the UI.

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=3000                     # HTTP port
# HOST=localhost                # Read but currently has no effect: reported by GET /api/config; the server listens on all interfaces
# HTTPS_PORT=3443               # HTTPS port (when ENABLE_HTTPS=true)
# ENABLE_HTTPS=false            # Also serve HTTPS with an mkcert certificate in ssl/
# SSL_DOMAIN=localhost          # Name on that certificate (127.0.0.1 and ::1 are added)
# FORCE_HTTPS=false             # 301 every plain-HTTP request to HTTPS_PORT (needs ENABLE_HTTPS=true), except /api/health and /scep
# Which proxies may set X-Forwarded-For/-Proto (rate-limit client IP, HTTPS detection).
# true, false, a hop count, or comma-separated addresses, CIDRs or loopback/linklocal/uniquelocal.
# The default trusts any private-LAN client, which can then spoof those headers: prefer
# "loopback" (proxy on the same host) or the proxy's exact IP / container subnet. Environment only.
# TRUST_PROXY=loopback,linklocal,uniquelocal
# NODE_ENV=                     # Unset by default; "development" adds validation details to 400 responses (500s never carry error details)
# ALLOWED_ORIGINS=              # Comma-separated origins allowed cross-origin (CORS); empty = same-origin only
# THEME_MODE=light              # Default UI theme for new browsers: dark or light (the Docker image sets dark)
# THEME_PRIMARY_COLOR=#007bff   # Read but currently has no effect
# THEME_DARK_MODE=false         # Read but currently has no effect (use THEME_MODE)

# ── Authentication ───────────────────────────────────────────────────────────
# ENABLE_AUTH=false             # Require a login. Also needed for the settings page and OIDC.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=                # Unset or "admin": a random password is generated and printed at startup
# AUTH_PASSWORD_HASH=           # bcrypt hash; used instead of AUTH_PASSWORD when set
# SESSION_SECRET=               # Long random string (openssl rand -hex 48). Unset: a new one each start, so sessions don't survive restarts

# ── OpenID Connect (needs ENABLE_AUTH=true) ──────────────────────────────────
# ENABLE_OIDC=false
# OIDC_ISSUER=https://login.dev.local/realms/main   # Discovery: <issuer>/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CALLBACK_URL=http://localhost:3000/auth/oidc/callback   # Register this, and <same origin>/login as a post-logout redirect URI
# OIDC_SCOPE=openid profile email

# ── Rate limits (windows in milliseconds) ────────────────────────────────────
# CLI_RATE_LIMIT_WINDOW=900000  # Certificate operations, CA actions, tests
# CLI_RATE_LIMIT_MAX=10
# API_RATE_LIMIT_WINDOW=900000  # Upload, notifications, SCEP, settings
# API_RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_WINDOW=900000 # Login attempts
# AUTH_RATE_LIMIT_MAX=5

# ── Storage ──────────────────────────────────────────────────────────────────
# UPLOADED_CERTS_DIR=certificates/uploaded   # Where uploads are saved (relative to the working directory)
# CERTIFICATES_DIR=certificates              # Folder the expiry monitor scans (the UI always lists ./certificates)
# CAROOT=                                    # mkcert's CA directory; read by mkcert itself (default: mkcert -CAROOT)

# ── Expiry monitoring ────────────────────────────────────────────────────────
# CERT_MONITORING_ENABLED=false
# CERT_CHECK_INTERVAL=0 8 * * * # Cron, UTC (0 */6 * * * = every 6 hours)
# CERT_WARNING_DAYS=30
# CERT_CRITICAL_DAYS=7
# CERT_MONITOR_UPLOADED=true    # Scan the uploaded folder again (lists expiring uploads twice if it is inside certificates/)

# ── Email (examples/email-*.env have provider presets) ───────────────────────
# EMAIL_NOTIFICATIONS_ENABLED=false
# SMTP_HOST=smtp.dev.local      # Host, user, password and EMAIL_TO are all required
# SMTP_PORT=587
# SMTP_SECURE=false             # true for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# EMAIL_FROM=mkcert-web-ui@localhost
# EMAIL_TO=                     # Comma-separated
# EMAIL_SUBJECT=Certificate Expiry Alert - mkcert Web UI

# ── ntfy ─────────────────────────────────────────────────────────────────────
# NTFY_ENABLED=false
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=                   # Bearer token (takes priority over username/password)
# NTFY_USERNAME=
# NTFY_PASSWORD=
# NTFY_PRIORITY=default         # Read but currently has no effect: alerts use high (warning) or urgent (critical)

# ── Webhook (custom headers: config/settings.json only) ──────────────────────
# WEBHOOK_ENABLED=false
# WEBHOOK_URL=

# ── SCEP ─────────────────────────────────────────────────────────────────────
# SCEP_ALLOW_OPEN_ENROLLMENT=false   # true accepts enrollment without a challenge password
# SCEP_ALLOWED_DOMAINS=              # Comma-separated name suffixes the SCEP CA will sign, e.g. dev.local,test

# ── Enterprise CA for SCEP manual enrollment (instead of mkcert) ─────────────
# ENTERPRISE_CA_ENABLED=false
# ENTERPRISE_CA_CERT_PATH=
# ENTERPRISE_CA_KEY_PATH=
# ENTERPRISE_CA_CHAIN_PATH=
# ENTERPRISE_CA_DEFAULT_TEMPLATE=User
# ENTERPRISE_CA_M365_TEMPLATE=M365User
# ENTERPRISE_CA_VALIDITY_DAYS=365
# ENTERPRISE_CA_KEY_SIZE=2048
# ENTERPRISE_CA_HASH_ALGORITHM=sha256
