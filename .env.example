# mkcert Web UI configuration
#
# Copy to .env and uncomment what you need. The values shown are the defaults
# unless a comment says otherwise. This lists every variable the server reads,
# including a few that are read but currently have no effect (marked so).
#
# Any variable that is set here (even to an empty value) overrides the value
# saved on the settings page (config/settings.json). Leave a line commented out
# if you want to manage that setting from the UI.
#
# Comments go on their own line: `docker run --env-file` keeps an inline
# "# ..." as part of the value (dotenv strips it, Docker does not).

# ── Server ───────────────────────────────────────────────────────────────────
# HTTP port
# PORT=3000
# Read but currently has no effect: reported by GET /api/config; the server listens on all interfaces
# HOST=localhost
# HTTPS port (when ENABLE_HTTPS=true)
# HTTPS_PORT=3443
# Also serve HTTPS with an mkcert certificate in ssl/
# ENABLE_HTTPS=false
# Name on that certificate (127.0.0.1 and ::1 are added)
# SSL_DOMAIN=localhost
# Redirect every plain-HTTP request to HTTPS_PORT (301 for GET/HEAD, 308 otherwise; needs ENABLE_HTTPS=true), except /api/health and /scep
# FORCE_HTTPS=false
# Which proxies may set X-Forwarded-For/-Proto (rate-limit client IP, HTTPS detection).
# true, false, a hop count, or comma-separated addresses, CIDRs or loopback/linklocal/uniquelocal.
# The default trusts any private-LAN client, which can then spoof those headers. Set it to the
# proxy's address as the app sees it: "loopback" when proxy and app share a host without Docker;
# in Docker, the network gateway (proxy on the host via a published port, e.g. 172.17.0.1) or the
# proxy container's IP / network subnet. See docs/DOCKER.md. Environment only.
# TRUST_PROXY=loopback,linklocal,uniquelocal
# Unset by default; "development" adds validation details to 400 responses (500s never carry error details)
# NODE_ENV=
# Comma-separated origins allowed cross-origin (CORS); empty = same-origin only
# ALLOWED_ORIGINS=
# Default UI theme for new browsers: dark or light (the Docker image sets dark)
# THEME_MODE=light
# Read but currently has no effect
# THEME_PRIMARY_COLOR=#007bff
# Read but currently has no effect (use THEME_MODE)
# THEME_DARK_MODE=false

# ── Authentication ───────────────────────────────────────────────────────────
# Require a login. Also needed for the settings page and OIDC.
# ENABLE_AUTH=false
# AUTH_USERNAME=admin
# Unset or "admin": a random password is generated and printed at startup
# AUTH_PASSWORD=
# bcrypt hash; used instead of AUTH_PASSWORD when set
# AUTH_PASSWORD_HASH=
# Long random string (openssl rand -hex 48). Unset: a new one each start, so sessions don't survive restarts
# SESSION_SECRET=

# ── OpenID Connect (needs ENABLE_AUTH=true) ──────────────────────────────────
# ENABLE_OIDC=false
# Discovery: <issuer>/.well-known/openid-configuration
# OIDC_ISSUER=https://login.dev.local/realms/main
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Register this, and <same origin>/login as a post-logout redirect URI
# OIDC_CALLBACK_URL=http://localhost:3000/auth/oidc/callback
# OIDC_SCOPE=openid profile email

# ── Rate limits (windows in milliseconds) ────────────────────────────────────
# Certificate operations, CA actions, tests
# CLI_RATE_LIMIT_WINDOW=900000
# CLI_RATE_LIMIT_MAX=10
# Upload, notifications, SCEP, settings
# API_RATE_LIMIT_WINDOW=900000
# API_RATE_LIMIT_MAX=100
# Login attempts
# AUTH_RATE_LIMIT_WINDOW=900000
# AUTH_RATE_LIMIT_MAX=5

# ── Storage ──────────────────────────────────────────────────────────────────
# Where uploads are saved (relative to the working directory)
# UPLOADED_CERTS_DIR=certificates/uploaded
# Folder the expiry monitor scans (the UI always lists ./certificates)
# CERTIFICATES_DIR=certificates
# mkcert's CA directory; read by mkcert itself (default: mkcert -CAROOT)
# CAROOT=

# ── Expiry monitoring ────────────────────────────────────────────────────────
# CERT_MONITORING_ENABLED=false
# Cron, UTC (0 */6 * * * = every 6 hours)
# CERT_CHECK_INTERVAL=0 8 * * *
# CERT_WARNING_DAYS=30
# CERT_CRITICAL_DAYS=7
# Scan the uploaded folder again (lists expiring uploads twice if it is inside certificates/)
# CERT_MONITOR_UPLOADED=true

# ── Email (examples/email-*.env have provider presets) ───────────────────────
# EMAIL_NOTIFICATIONS_ENABLED=false
# Host, user, password and EMAIL_TO are all required
# SMTP_HOST=smtp.dev.local
# SMTP_PORT=587
# true for implicit TLS (port 465)
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# EMAIL_FROM=mkcert-web-ui@localhost
# Comma-separated
# EMAIL_TO=
# EMAIL_SUBJECT=Certificate Expiry Alert - mkcert Web UI

# ── ntfy ─────────────────────────────────────────────────────────────────────
# NTFY_ENABLED=false
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=
# Bearer token (takes priority over username/password)
# NTFY_TOKEN=
# NTFY_USERNAME=
# NTFY_PASSWORD=
# Read but currently has no effect: alerts use high (warning) or urgent (critical)
# NTFY_PRIORITY=default

# ── Webhook (custom headers: config/settings.json only) ──────────────────────
# WEBHOOK_ENABLED=false
# WEBHOOK_URL=

# ── SCEP ─────────────────────────────────────────────────────────────────────
# true accepts enrollment without a challenge password
# SCEP_ALLOW_OPEN_ENROLLMENT=false
# Comma-separated name suffixes the SCEP CA will sign, e.g. dev.local,test
# SCEP_ALLOWED_DOMAINS=

# ── Enterprise CA for SCEP manual enrollment (instead of mkcert) ─────────────
# ENTERPRISE_CA_ENABLED=false
# ENTERPRISE_CA_CERT_PATH=
# ENTERPRISE_CA_KEY_PATH=
# ENTERPRISE_CA_CHAIN_PATH=
# ENTERPRISE_CA_DEFAULT_TEMPLATE=User
# ENTERPRISE_CA_M365_TEMPLATE=M365User
# ENTERPRISE_CA_VALIDITY_DAYS=365
# ENTERPRISE_CA_KEY_SIZE=2048
# ENTERPRISE_CA_HASH_ALGORITHM=sha256
