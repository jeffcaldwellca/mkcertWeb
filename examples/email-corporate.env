# Example Email Configuration for Corporate SMTP Server

# 1. Enable email notifications
EMAIL_NOTIFICATIONS_ENABLED=true

# 2. Corporate SMTP Configuration
# Your company's SMTP server
SMTP_HOST=mail.company.com
# Standard TLS port (or 25 for unencrypted, 465 for SSL)
SMTP_PORT=587
# Set to true if using port 465 (SSL)
SMTP_SECURE=false
# Service account email
SMTP_USER=mkcert-service@company.com
SMTP_PASSWORD=service-account-password
# Set to false for self-signed corporate certificates
SMTP_TLS_REJECT_UNAUTHORIZED=false

# 3. Email settings
EMAIL_FROM=mkcert-web-ui@company.com
EMAIL_TO=sysadmin@company.com,devops@company.com,security-team@company.com
EMAIL_SUBJECT=🔒 Certificate Expiry Alert - Internal mkcert Service

# 4. Certificate Monitoring
CERT_MONITORING_ENABLED=true
# Every 6 hours (more frequent for enterprise)
CERT_CHECK_INTERVAL=0 */6 * * *
# Enterprise may want longer warning periods
CERT_WARNING_DAYS=60
# 3 weeks for critical alerts
CERT_CRITICAL_DAYS=21
# Uploads are already scanned with certificates/; true would alert on them twice
CERT_MONITOR_UPLOADED=false

# Common Corporate SMTP Settings:
# 
# Microsoft Exchange:
# - SMTP_HOST=mail.company.com or exchange.company.com
# - SMTP_PORT=587 (usually)
# - SMTP_SECURE=false
# - May require domain authentication (DOMAIN\username)
#
# Postfix/Sendmail:
# - SMTP_HOST=smtp.company.com
# - SMTP_PORT=25 (internal) or 587 (authenticated)
# - mkcert Web UI requires SMTP_USER and SMTP_PASSWORD; an unauthenticated relay is not supported
#
# For internal certificates or self-signed SMTP:
# - Set SMTP_TLS_REJECT_UNAUTHORIZED=false
